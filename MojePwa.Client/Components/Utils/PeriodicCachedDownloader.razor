@typeparam TData
@inherits ComponentWithGuiState<PeriodicCachedDownloader<TData>.LoadedData>
@implements IDisposable
@inject BrowserTtlCache LocalTtlCache

<StateSwitch TData="LoadedData" Context="data" State="GuiState" LoadingContent="LoadingContent"
             ErrorContent="ErrorContent" OnRetry="OnRetry">
    @ChildContent?.Invoke(data.Data)
    <div>
        <b>Čas načtení: </b> @data.LoadedUtc.ToLocalTime().ToString("HH:mm:ss")
    </div>
</StateSwitch>

@code {
    [Parameter] public RenderFragment<TData>? ChildContent { get; set; }
    [Parameter] public RenderFragment<StateLoading>? LoadingContent { get; set; }
    [Parameter] public RenderFragment<StateError>? ErrorContent { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public string CacheKey { get; set; } = string.Empty;
    [Parameter] public Func<Task<Result<TData>>> LoadFreshData { get; set; } = default!;
    [Parameter] public TimeSpan DataReloadPeriod { get; set; } = TimeSpan.FromMinutes(1);

    protected override string LoadingMessage { get; set; } = string.Empty;

    CancellationTokenSource? _cts;
    readonly SemaphoreSlim _reloadLock = new(1, 1);
    string _previousCacheKey = string.Empty;

    public class LoadedData
    {
        public required TData Data { get; set; }
        public required DateTime LoadedUtc { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_previousCacheKey == CacheKey)
            return;

        _previousCacheKey = CacheKey;
        await LoadAndSetGuiStateAsync();
        StartPeriodicReload();
    }

    void StartPeriodicReload()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        var token = _cts.Token;

        _ = Task.Run(async () =>
        {
            using var periodicTimer = new PeriodicTimer(DataReloadPeriod);

            try
            {
                while (await periodicTimer.WaitForNextTickAsync(token))
                {
                    await PerformBackgroundReloadAsync(token);
                }
            }
            catch (OperationCanceledException)
            {
                // Není to chyba. Je to ukončení (Dispose / Změna parametrů)
            }
        }, token);
    }

    // Periodický reload dat na pozadí. Pokud stále probíhá předchozí reload, tak se další nespustí.
    async Task PerformBackgroundReloadAsync(CancellationToken cancellationToken)
    {
        if (!await _reloadLock.WaitAsync(0, cancellationToken))
            return;

        try
        {
            if (GuiState is not StateLoaded<LoadedData> loaded)
                return;

            // 1. Překlopení UI indikátoru načítání
            await InvokeAsync(() =>
            {
                loaded.IsReloading = true;
                StateHasChanged();
            });

            // 2. Načtení čerstvých dat ze zdroje
            var fresh = await LoadFreshData();

            // 3. Příprava nového stavu a zápis do cache (na pozadí, Mimo InvokeAsync!)
            LoadedData? newLoadedData = null;
            StateError? newError = null;

            if (fresh.Succeeded)
            {
                newLoadedData = new LoadedData { Data = fresh.Value, LoadedUtc = DateTime.UtcNow };

                if (!string.IsNullOrEmpty(CacheKey))
                {
                    await LocalTtlCache.StoreAsync(CacheKey, fresh.Value, DataReloadPeriod - TimeSpan.FromSeconds(1));
                }
            }
            else
            {
                newError = new StateError(fresh.Errors);
            }

            // 4. Přepnutí do nového stavu UI
            await InvokeAsync(() =>
            {
                if (newLoadedData != null)
                    loaded.LoadedData = newLoadedData;
                else if (newError != null)
                    GuiState = newError;
                StateHasChanged(); // Vynutí překreslení s novými daty!
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                GuiState = new StateError("Unexpected error occurred");
                StateHasChanged();
            });
        }
        finally
        {
            if (GuiState is StateLoaded<LoadedData> loadedAfter)
            {
                await InvokeAsync(() =>
                {
                    loadedAfter.IsReloading = false;
                    StateHasChanged();
                });
            }

            _reloadLock.Release();
        }
    }

    protected override async Task<Result<LoadedData>> LoadDataAsync()
    {
        if (!string.IsNullOrEmpty(CacheKey))
        {
            var cached = await LocalTtlCache.TryGetAsync<TData>(CacheKey);
            if (cached.Succeeded)
                return Result.Ok(new LoadedData { Data = cached.Value.CachedValue, LoadedUtc = cached.Value.StoredUtc });
        }

        var fresh = await LoadFreshData();
        if (fresh.Succeeded && !string.IsNullOrEmpty(CacheKey))
        {
            await LocalTtlCache.StoreAsync(CacheKey, fresh.Value, DataReloadPeriod - TimeSpan.FromSeconds(1));
        }

        return fresh.MapValue(_fresh => new LoadedData { Data = _fresh, LoadedUtc = DateTime.UtcNow });
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _reloadLock.Dispose();
    }
}