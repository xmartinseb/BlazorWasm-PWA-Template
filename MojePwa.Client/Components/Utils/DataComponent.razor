@typeparam TData
@implements IDisposable

@if (ViewModel is { GuiState: not null })
{
        <StateSwitch TData="DataWithTimestamp<TData>" Context="data" State="ViewModel.GuiState" LoadingContent="LoadingContent"
                     ErrorContent="ErrorContent" OnRetry="OnRetryAsync">
        @ChildContent?.Invoke(data.Data)
        @if (ShowTimestamp)
        {
            <div>
                <b>Čas načtení: </b> @data.Loaded.ToLocalTime().ToString("HH:mm:ss")
            </div>
        }
    </StateSwitch>
}

@code {
    [Parameter] public RenderFragment<TData>? ChildContent { get; set; }
    [Parameter] public RenderFragment<StateLoading>? LoadingContent { get; set; }
    [Parameter] public RenderFragment<StateError>? ErrorContent { get; set; }
    [Parameter] public DataViewModel<TData> ViewModel { get; set; } = null!;

    /// <summary>
    /// Pokud je true, pod vypsanými daty se vypíše lokální čas poslední aktualizace dat
    /// </summary>
    [Parameter] public bool ShowTimestamp { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        if (ViewModel is null)
            throw new ArgumentException("DataComponent nemůže mít ViewModel NULL");

        if (ReferenceEquals(_subscribed, ViewModel))
            return;

        if (_subscribed is not null)
        {
            _subscribed.BlazorStateHasChanged -= OnBlazorStateHasChanged;
            _subscribed.StopPeriodicReload();
        }
        _lifetimeCts?.Cancel();
        _lifetimeCts?.Dispose();
        _lifetimeCts = new();
        _subscribed = ViewModel;
        ViewModel.BlazorStateHasChanged += OnBlazorStateHasChanged;

        var currentCacheKey = ViewModel.CacheUsage?.CacheKey;

        if (ViewModel.CacheUsage is not null && string.IsNullOrWhiteSpace(currentCacheKey))
            throw new InvalidOperationException("Prázdný string není validní cache key.");

        if (ViewModel.DataReloadPeriod is not null)
            ViewModel.StartPeriodicReload();
        else
            await ViewModel.LoadAndSetGuiStateAsync("Loading...", _lifetimeCts.Token);
    }

    DataViewModel<TData>? _subscribed;
    CancellationTokenSource? _lifetimeCts;

    Task OnRetryAsync() => ViewModel.OnRetryClickAsync(_lifetimeCts!.Token);

    async void OnBlazorStateHasChanged(object? sender, EventArgs e) => await InvokeAsync(StateHasChanged);

    public void Dispose() 
    {
        if (_subscribed is not null)
        {
            _subscribed.BlazorStateHasChanged -= OnBlazorStateHasChanged;
            _subscribed.StopPeriodicReload();
        }
        _lifetimeCts?.Cancel();
        _lifetimeCts?.Dispose();
    }
}