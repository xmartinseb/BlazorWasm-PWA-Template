@page "/test"
@implements IDisposable
@inject ITestApiService TestApiService

<h2>Test API</h2>
<div>
    <DataComponent TViewModel="TestViewModel" TDataLoaded="string" ViewModel="DataViewModels[0]" Context="viewModel">
        <span>@viewModel.Value</span>
    </DataComponent>
    <DataComponent TViewModel="TestViewModel" TDataLoaded="string" ViewModel="DataViewModels[1]" Context="viewModel">
        <span>@viewModel.Value</span>
    </DataComponent>
</div>

@code {
    TestApiViewModel[] DataViewModels { get; set; } = [];

    readonly CancellationTokenSource _lifetimeCts = new();

    sealed class TestApiViewModel(ITestApiService testApiService) : DataViewModel<TestViewModel, string>(
        dataReloadPeriod: TimeSpan.FromSeconds(3),
        cacheUsage: null,
        browserTtlCache: null)
    {
        public override Task<Result<string>> LoadFreshDataAsync(CT ct) => testApiService.TestApiGetAsync(ct);

        public override TestViewModel CreateViewModel(string firstLoadedData) => new(firstLoadedData);

        public override void UpdateViewModel(TestViewModel currentViewModel, string newData)
            => currentViewModel.Value = newData;
    }

    sealed class TestViewModel(string value)
    {
        public string Value { get; set; } = value;
    }

    protected override void OnInitialized() => DataViewModels = [new(TestApiService), new(TestApiService)];

    public void Dispose()
    {
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
    }
}