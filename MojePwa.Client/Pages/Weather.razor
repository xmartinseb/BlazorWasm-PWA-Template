@* This component demonstrates fetching data from the server via services *@
@page "/weather"
@inject IWeatherService WeatherService
@inject BrowserTtlCache BrowserTtlCache

<h2>Weather</h2>
<DataComponent TData="LoadedDataVm" ViewModel="DataViewModel" Context="vm">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th aria-label="Temperature in Celsius">Temp. (C)</th>
                <th aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in vm.Forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
</DataComponent>

@code {
    WeatherDataViewModel? DataViewModel { get; set; }

    sealed class WeatherDataViewModel(BrowserTtlCache cache, IWeatherService weatherService) : DataViewModel<LoadedDataVm>(
            dataReloadPeriod: TimeSpan.FromSeconds(2),
            cacheUsage: new(TimeSpan.FromSeconds(2), BrowserStorageType.Session, cacheKey: "WEATHER"),
            cache)
    {
        public override async Task<Result<LoadedDataVm>> LoadFreshDataAsync(CT ct)
            => Result.Ok(new LoadedDataVm((await weatherService.GetForecastAsync(CT.None)).Unwrap()));
    }

    sealed record LoadedDataVm(WeatherForecast[] Forecasts);

    protected override void OnInitialized() => DataViewModel = new(BrowserTtlCache, WeatherService);
}