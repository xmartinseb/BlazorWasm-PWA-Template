@* This component demonstrates fetching data from the server via services *@
@page "/weather"
@inject IWeatherService WeatherService
@inject BrowserTtlCache BrowserTtlCache

<h2>Weather</h2>
<DataComponent TViewModel="ViewModel" TDataLoaded="WeatherForecast[]" ViewModel="DataViewModel" OnViewModelUpdated="RefreshGridAsync" Context="vm">
    <RadzenDataGrid @ref="_weatherGrid" Data="@vm.Forecasts" TItem="WeatherForecast" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="WeatherForecast" Property="Date" Title="Date" FormatString="{0:d}" />
            <RadzenDataGridColumn TItem="WeatherForecast" Property="TemperatureC" Title="Temp. (C)" />
            <RadzenDataGridColumn TItem="WeatherForecast" Property="TemperatureF" Title="Temp. (F)" />
            <RadzenDataGridColumn TItem="WeatherForecast" Property="Summary" Title="Summary" />
        </Columns>
    </RadzenDataGrid>
</DataComponent>

@code {
    WeatherDataViewModel? DataViewModel { get; set; }
    RadzenDataGrid<WeatherForecast>? _weatherGrid;

    sealed class WeatherDataViewModel(BrowserTtlCache cache, IWeatherService weatherService) : DataViewModel<ViewModel, WeatherForecast[]>(
            dataReloadPeriod: TimeSpan.FromSeconds(2),
            cacheUsage: new(TimeSpan.FromSeconds(1), BrowserStorageType.Session, cacheKey: "WEATHER"),
            cache)
    {
        public override Task<Result<WeatherForecast[]>> LoadFreshDataAsync(CT ct) 
            => weatherService.GetForecastAsync(ct);

        public override ViewModel CreateViewModel(WeatherForecast[] firstLoadedData) 
            => new(firstLoadedData.ToList());

        public override void UpdateViewModel(ViewModel currentViewModel, WeatherForecast[] newData)  
            => currentViewModel.Forecasts.ClearAddRange(newData);
    }

    sealed record ViewModel(List<WeatherForecast> Forecasts);

    Task RefreshGridAsync() => _weatherGrid?.RefreshDataAsync() ?? Task.CompletedTask;

    protected override void OnInitialized() => DataViewModel = new(BrowserTtlCache, WeatherService);
}