@page "/fake-data"
@inject IFakeDataService FakeDataService
@inject BrowserTtlCache BrowserTtlCache
@inject DialogService DialogService

<h2>Fake Data</h2>
<div>
    <DataComponent TData="LoadedDataVm" ViewModel="DataViewModel" Context="vm">
        @switch (vm.FakeData.Count)
        {
            case 0:
                <div>Fake databáze je prázdná</div>
                break;
            case > 0:
                foreach (var item in vm.FakeData)
                {
                    <div>
                        <b>@item.Key:</b> @item.Value
                    </div>
                }
                break;
        }

        <RadzenButton Click="() => AddFakeDataClick(vm)" class="mt-5">Přidat fake data</RadzenButton>
    </DataComponent>
</div>

@code {
    FakeDataViewModel? DataViewModel { get; set; }

    sealed class FakeDataViewModel(BrowserTtlCache cache, IFakeDataService fakeDataService) : DataViewModel<LoadedDataVm>(
        dataReloadPeriod: TimeSpan.FromSeconds(5),
        cacheUsage: new(TimeSpan.FromSeconds(3), BrowserStorageType.Session, cacheKey: "FAKE_DATA"),
        cache)
    {
        public override async Task<Result<LoadedDataVm>> LoadFreshDataAsync(CT ct)
            => Result.Ok(new LoadedDataVm((await fakeDataService.GetAllDataAsync(CT.None)).Unwrap()));
    }

    sealed record LoadedDataVm(Dictionary<string, string> FakeData);

    protected override void OnInitialized() => DataViewModel = new(BrowserTtlCache, FakeDataService);

    async Task AddFakeDataClick(LoadedDataVm vm)
    {
        if (await AddFakeDataDialog.ShowAsync(DialogService) is { } dialogResult)
        {
            vm.FakeData[dialogResult.NewKey] = dialogResult.NewValue;
            await DataViewModel!.StoreCacheAsync(vm, CT.None);
        }
    }
}