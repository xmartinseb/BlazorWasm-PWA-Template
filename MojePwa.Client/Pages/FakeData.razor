@page "/fake-data"
@implements IDisposable
@inject IFakeDataService FakeDataService
@inject BrowserTtlCache BrowserTtlCache
@inject DialogService DialogService

<h2>Fake Data</h2>
<div>
    <DataComponent TViewModel="LoadedDataVm" TDataLoaded="Dictionary<string, string>" ViewModel="DataViewModel" Context="vm">
        @switch (vm.FakeData.Count)
        {
            case 0:
                <div>Fake databáze je prázdná</div>
                break;
            case > 0:
                foreach (var item in vm.FakeData)
                {
                    <div>
                        <b>@item.Key:</b> @item.Value
                    </div>
                }
                break;
        }

        <RadzenButton Click="AddFakeDataClick" class="mt-5">Přidat fake data</RadzenButton>
    </DataComponent>
</div>

@code {
    FakeDataViewModel? DataViewModel { get; set; }
    readonly CancellationTokenSource _lifetimeCts = new();

    sealed class FakeDataViewModel(BrowserTtlCache cache, IFakeDataService fakeDataService) : DataViewModel<LoadedDataVm, Dictionary<string, string>>(
        dataReloadPeriod: TimeSpan.FromSeconds(5),
        cacheUsage: new(TimeSpan.FromSeconds(3), BrowserStorageType.Session, cacheKey: "FAKE_DATA"),
        cache)
    {
        public override async Task<Result<Dictionary<string, string>>> LoadFreshDataAsync(CT ct)
            => Result.Ok((await fakeDataService.GetAllDataAsync(ct)).Unwrap());

        public override LoadedDataVm CreateViewModel(Dictionary<string, string> firstLoadedData) => new(firstLoadedData);

        public override void UpdateViewModel(LoadedDataVm currentViewModel, Dictionary<string, string> newData)
        {
            currentViewModel.FakeData.Clear();
            foreach (var item in newData)
                currentViewModel.FakeData[item.Key] = item.Value;
        }
    }

    sealed class LoadedDataVm(Dictionary<string, string> fakeData)
    {
        public Dictionary<string, string> FakeData { get; } = fakeData;
    }

    protected override void OnInitialized() => DataViewModel = new(BrowserTtlCache, FakeDataService);

    async Task AddFakeDataClick()
    {
        if (await AddFakeDataDialog.ShowAsync(DialogService) is { } addedRecord
            && DataViewModel?.TryGetViewModel() is { } loadedData)
        {
            loadedData.FakeData[addedRecord.Key] = addedRecord.Value;
            await DataViewModel.StoreCacheAsync(loadedData.FakeData, _lifetimeCts.Token);
        }
    }

    public void Dispose()
    {
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
    }
}