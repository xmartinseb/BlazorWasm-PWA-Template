@* Example page, která ukazuje rozdíly mezi Local storage a Session storage *@
@page "/counter"
@inject BrowserStoredValueFactory BrowserStoredValueFactory
@inject NotificationService NotificationService

<PageTitle>Counter</PageTitle>

<div>
    <h2>Local storage counter (= shared, permanent)</h2>
    <p role="status">Current local count: @currentLocalCount?.Value</p>
    <button class="btn btn-primary" @onclick="IncrementLocalCount">Click me</button>
</div>

<div class="mt-5">
    <h2>Session storage counter (= temporary, per-tab)</h2>
    <p role="status">Current session count: @currentSessionCount?.Value</p>
    <button class="btn btn-primary" @onclick="IncrementSessionCount">Click me</button>
</div>

@code {
    // Třída BrowserStoredValue umožňuje definovat cachovanou hodnotu jednou a poté manipulovat s hodnotou pomocí jednoduchých metod
    BrowserStoredValue<int> currentLocalCount = null!, currentSessionCount = null!;

    /// <summary>
    /// Local a Session storage mohou mít stejné cache keys bez konfliktu, protože to jsou nezávislá úložiště.
    /// Local session je sdílen mezi všemi okny a záložkami STEJNÉHO ORIGIN (protokol, doména, port), Session storage je per-záložka.
    /// </summary>
    const string StorageKey = "counter_value";

    // TODO: Lepší ošetření chyb

    // Načtení dat bezpečně až PO vygenerování HTML na klientovi (kvůli JS Interop / Prerenderingu)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        currentLocalCount ??= BrowserStoredValueFactory.Create<int>(StorageKey, BrowserStorageType.Local);
        currentSessionCount ??= BrowserStoredValueFactory.Create<int>(StorageKey, BrowserStorageType.Session);

        NotifyLoadError(await currentLocalCount.LoadAsync(0));
        NotifyLoadError(await currentSessionCount.LoadAsync(0));
        StateHasChanged(); // Vynutíme přerenderování UI po prvním načtení hodnot z JS
    }

    async Task IncrementLocalCount()
    {
        // Tato hodnota mohla být změněna v jiné záložce, proto se načte znovu (zabrání to konflikům záložek)
        var localValResult = await currentLocalCount.LoadAsync(0);
        if (NotifyLoadError(localValResult))
            return;
        await currentLocalCount.SetAsync(localValResult.Value + 1);
    }

    async Task IncrementSessionCount()
    { 
        // Tato hodnota mohla být mezitím změněna z jiné záložky (aktualizace GUI))
        NotifyLoadError(await currentLocalCount.LoadAsync(0));
        
        // Hodnota patří jen této záložce, není třeba volat Load, stačí Set. 
        // Jen nebude fungovat uživatelský zásah do hodnoty skrze console browseru, ale to nevadí.
        await currentSessionCount.SetAsync(currentSessionCount.Value + 1);
    }

    bool NotifyLoadError(Result<int> r)
    {
        if (!r.Succeeded)
            NotificationService.Error($"Selhalo načítání čítače: {string.Join("; ", r.Errors)}");
        return !r.Succeeded;
    }
}