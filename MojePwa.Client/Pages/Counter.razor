@page "/counter"
@inject BrowserStorage BrowserStorage


<PageTitle>Counter</PageTitle>

<div>
    <h2>Local storage counter (= shared, permanent)</h2>
    <p role="status">Current local count: @currentLocalCount</p>
    <button class="btn btn-primary" @onclick="IncrementLocalCount">Click me</button>
</div>

<div class="mt-5">
    <h2>Session storage counter (= temporary, per-tab)</h2>
    <p role="status">Current session count: @currentSessionCount</p>
    <button class="btn btn-primary" @onclick="IncrementSessionCount">Click me</button>
</div>

@code {
    int currentLocalCount, currentSessionCount;

    /// <summary>
    /// Local a Session storage mohou mít stejné cache keys bez konfliktu, protože to jsou nezávislá úložiště.
    /// Local session je sdílen mezi všemi okny a záložkami STEJNÉHO ORIGIN (protokol, doména, port), Session storage je per-záložka.
    /// </summary>
    const string StorageKey = "counter_value";

    // Načtení dat bezpečně až PO vygenerování HTML na klientovi (kvůli JS Interop / Prerenderingu)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentLocalCount = (await BrowserStorage.TryGetAsync<int>(BrowserStorageType.Local, StorageKey)).UnwrapOr(0);
            currentSessionCount = (await BrowserStorage.TryGetAsync<int>(BrowserStorageType.Session, StorageKey)).UnwrapOr(0);
            StateHasChanged(); // Vynutíme přerenderování UI po prvním načtení hodnot z JS
        }
    }

    async Task IncrementLocalCount()
    {
        currentLocalCount = (await BrowserStorage.TryGetAsync<int>(BrowserStorageType.Local, StorageKey)).UnwrapOr(0); // Tato hodnota mohla být mezitím změněna z jiné záložky (zabránění konfliktu)
        await BrowserStorage.SetAsync(BrowserStorageType.Local, StorageKey, ++currentLocalCount);
    }

    async Task IncrementSessionCount()
    { 
        currentLocalCount = (await BrowserStorage.TryGetAsync<int>(BrowserStorageType.Session, StorageKey)).UnwrapOr(0); // Tato hodnota mohla být mezitím změněna z jiné záložky (aktualizace GUI))
        await BrowserStorage.SetAsync(BrowserStorageType.Session, StorageKey, ++currentSessionCount);
    }
}